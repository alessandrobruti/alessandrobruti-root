{
  "headers": [
    {
      "source": "/ces-2026-analisi(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/ces-2026-analisi", "destination": "https://ces2026-analisi.vercel.app" },
    { "source": "/ces-2026-analisi/(.*)", "destination": "https://ces2026-analisi.vercel.app/$1" }
  ]
}
